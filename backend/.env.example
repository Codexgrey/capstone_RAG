# backend/.env.example
# Copy this file to backend/.env and fill in your values.
# Never commit the real .env to Git.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
POSTGRE_URL=postgresql://postgres:yourpassword@localhost:5432/ragdb

# ── JWT Auth ───────────────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_real_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── File Storage ───────────────────────────────────────────────────────────
STORAGE_PATH=./storage/documents
CHROMA_PERSIST_DIR=./chroma_storage

# ── LLM Backend ────────────────────────────────────────────────────────────
# Options: groq | openai | anthropic | placeholder
LLM_BACKEND=groq
GROQ_API_KEY=your_groq_api_key_here

# ── Project Root ───────────────────────────────────────────────────────────
# Absolute path to the capstone_RAG/ repository root.
# Used by the backend adapters to find the retrieval modules.
# Example (Linux/Mac): /home/user/capstone_RAG
# Example (Windows):   C:/Users/YourName/capstone_RAG
RAG_PROJECT_ROOT=/absolute/path/to/capstone_RAG
